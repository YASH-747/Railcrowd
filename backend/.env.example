# ============================================================
# RailCrowd — optional LIVE API integrations
# Copy this file to `.env` (same folder) and fill in ONLY the
# providers you have accounts for. Empty/missing values mean
# RailCrowd falls back to the public static data + model.
# ============================================================

# ------------------------------------------------------------
# 1) LIVE TRAIN RUNNING STATUS (delay / live position)
#    → Indian Railways official NTES / RailTel "Train Enquiry"
#      partner API. You need a B2B/partner account from
#      IRCTC / CRIS / RailTel to get a base URL + API key.
# ------------------------------------------------------------
NTES_API_BASE=
NTES_API_KEY=

# ------------------------------------------------------------
# 2) AUTHORISED IRCTC DATA (seat availability / PNR / schedule)
#    → IRCTC Partner / API-access program (enterprise account).
# ------------------------------------------------------------
IRCTC_API_BASE=
IRCTC_API_KEY=

# ------------------------------------------------------------
# 3) COMMERCIAL RAIL DATA PROVIDER (e.g. RailAPI.com, RailYatri,
#    ConfirmTkt / ixigo enterprise). Any provider with a
#    "train status" JSON endpoint + apikey works.
# ------------------------------------------------------------
RAILWAYAPI_BASE=
RAILWAYAPI_KEY=

# ------------------------------------------------------------
# 4) STATION WEATHER (fully supported — free tier available)
#    → https://home.openweathermap.org/users/sign_up
#    Grab "API keys" from your dashboard.
# ------------------------------------------------------------
OPENWEATHER_API_KEY=

# ------------------------------------------------------------
# 5) GOOGLE MAPS (station geocoding / static map tiles)
#    → https://console.cloud.google.com → enable Maps/Geocoding
# ------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------
# 6) COMMUNITY REPORTS DATABASE  (required on Vercel so votes
#    persist and affect crowd ratings in REAL TIME)
#
#    Easiest: use the Vercel ↔ Neon integration — it AUTO-INJECTS
#    DATABASE_URL (+ PG* vars). Nothing to copy by hand.
#    Or paste your Neon "pooled connection string" here / into the
#    Vercel Environment Variables:
#    DATABASE_URL=postgresql://user:pass@ep-....neon.tech/neondb?sslmode=require
#
#    Also supported (auto-detected in this order):
#      DATABASE_URL / POSTGRES_URL
#      DATABASE_URL_UNPOOLED / POSTGRES_URL_NON_POOLING
#      PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD
#    The `reports` table is created automatically on first use.
#    (Local dev without any of these simply uses data/reports.json.)
# ------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
KV_REST_API_URL=
KV_REST_API_TOKEN=
